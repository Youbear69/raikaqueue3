{
  "rules": {
    "queue": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null && root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['name', 'time', 'uid', 'status']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 25 && (newData.child('status').val() === 'waiting' || (auth.token.email != null && root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null && root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
    },
    "games": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null && root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
    },
    "history": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null && root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
    },
    "terms": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null && root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
    },
    "winrate": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null && root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
    },
    "userStats": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null && root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
    },
    "adminEmails": {
      ".read": "!data.exists() || (auth != null && auth.token.email != null && root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
      ".write": "auth != null && auth.token.email != null && (root.child('adminEmails').child(auth.token.email.toLowerCase().replace('.', ',')).exists() || !root.child('adminEmails').exists())",
      "$email": {
        ".read": true
      }
    }
  }
}
